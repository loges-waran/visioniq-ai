# VisionIQ AI Backend Environment Configuration

# OpenAI API Configuration (Leave blank or default to use built-in Mock Reasoning Engine)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Database & History Settings
DATABASE_URL=sqlite+aiosqlite:///./visioniq.db
ENABLE_HISTORY_BY_DEFAULT=true

# Server & Timeout Settings
REQUEST_TIMEOUT_SECONDS=25.0
MAX_IMAGE_SIZE_MB=10
